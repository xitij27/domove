# Copy to .env (gitignored) and fill in. All free tier.

# --- Shipped in the app (EXPO_PUBLIC_ values are bundled into the JS, so only public keys here) ---
# Mapbox public token (starts with pk.): https://console.mapbox.com/account/access-tokens/
EXPO_PUBLIC_MAPBOX_TOKEN=
# Supabase dashboard → Project Settings → API: project URL and publishable key (sb_publishable_...).
# Never the secret key (sb_secret_...); the app doesn't need it.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional. Google Cloud key restricted to "Maps SDK for Android": https://console.cloud.google.com/google/maps-apis/credentials
# Without it the app only offers Mapbox (Google Maps crashes on Android without a key).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Build/dev machine only (never prefix these with EXPO_PUBLIC_) ---
# For applying database migrations. Supabase dashboard → Connect → "Session pooler" string (works on IPv4),
# with your DB password filled in. Optional: leave empty if you'd rather run the SQL yourself in the SQL editor.
SUPABASE_DB_URL=
