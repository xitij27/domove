# Supabase Postgres connection string for Drizzle.
#
# Where to find it: Supabase dashboard → Project Settings → Database →
# Connection string. Use the POOLER (port 6543, transaction mode) URL for
# serverless/local dev, e.g.:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Direct (port 5432) also works for local dev. This role bypasses RLS, which
# is what the backend wants; the anon/publishable key path still respects RLS.
DATABASE_URL=postgresql://postgres:<password>@<host>:6543/postgres

# Obstacle-detection event loop (src/lib/detect.ts).
#
# Dortmund open-data base (Opendatasoft v2.1, no auth needed).
DORTMUND_ODS_BASE=https://open-data.dortmund.de
# Routing engine for route polylines (OSRM API, keyless demo server).
# Modality mapping: car→driving, bike→bike, pedestrian→foot.
ROUTING_BASE_URL=https://router.project-osrm.org
# Run the detection pass every N ms (default 15 min). First pass runs ~10s
# after boot. Set DISABLE_DETECTION=1 to turn the loop off (e.g. on Vercel —
# trigger POST /api/detect/run from an external cron instead).
DETECTION_INTERVAL_MS=900000
DISABLE_DETECTION=
# Match tuning: a site counts as "on the way" when its area (or, while geom
# is null, its centroid buffered by the area-equivalent radius
# sqrt(area_sqm/pi), else SITE_FALLBACK_RADIUS_M) intersects the route line
# buffered by ROUTE_BUFFER_M. Meters.
ROUTE_BUFFER_M=30
SITE_FALLBACK_RADIUS_M=25
